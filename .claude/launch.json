{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "videoeditory",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["run.py"],
      "port": 8000
    },
    {
      "name": "videoeditory-windows",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["run.py"],
      "port": 8000
    },
    {
      "name": "videoeditory-windows-test",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010
    }
  ]
}
